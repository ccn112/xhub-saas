# ===== xhub-web (frontend) =====
# Copy thành `.env.local` (đã có sẵn). Chỉ biến NEXT_PUBLIC_* mới lộ ra client.

# Base URL của xhub-api. Phase 1.5 Stage B: backend giờ chạy 2 process riêng
# (npm run start:platform / start:xoffice trong xhub-api) — 2 cặp biến dưới
# đây trỏ tới từng process. Không có đuôi "/".
# XHub Platform (control plane/master data/backup/webhook/launch-catalog-...):
XHUB_API_URL=http://localhost:4000
NEXT_PUBLIC_XHUB_API_URL=http://localhost:4000
# X.Office (workflow engine/requests/directives/.../people/ioc/delivery):
XOFFICE_API_URL=http://localhost:4001
NEXT_PUBLIC_XOFFICE_API_URL=http://localhost:4001
