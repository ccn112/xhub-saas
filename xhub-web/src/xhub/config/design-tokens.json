  "font": {
    "heading": "Plus Jakarta Sans",
    "body": "Inter",
    "size": {
      "xs": 12,
      "sm": 13,
      "md": 14,
      "lg": 16,
      "xl": 20,
      "2xl": 28,
      "3xl": 34
