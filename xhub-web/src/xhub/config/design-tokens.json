{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "XHub / X.Space Light Enterprise",
    "version": "1.0.0"
  },
  "color": {
    "navy900": "#071C3F",
    "navy800": "#0A2A58",
    "blue600": "#1769E0",
    "blue500": "#2D7FF9",
    "cyan500": "#16B8D4",
    "green500": "#22A06B",
    "orange500": "#F59E0B",
    "red500": "#EF4444",
    "purple500": "#7C5CFC",
    "gray950": "#0F172A",
    "gray700": "#334155",
    "gray500": "#64748B",
    "gray300": "#CBD5E1",
    "gray200": "#E2E8F0",
    "gray100": "#F1F5F9",
    "white": "#FFFFFF"
