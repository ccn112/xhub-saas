# ===== xhub-api (X.Office backend) =====
# Copy file này thành `.env` rồi điền giá trị thật. `.env` KHÔNG commit.

# Cổng server
PORT=4000

# --- Postgres local (cho Prisma / X.Office thật) ---
# Sửa user/password/db theo Postgres máy bạn. DB nên tạo sẵn (vd: createdb xhub).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/xhub?schema=public"

# Optional — chỉ cần cho `prisma migrate dev` và `npm run migrate:drift-check`.
# Phải là DB rỗng, dùng-để-xoá-tuỳ-ý (Prisma tự tạo/xoá bảng ở đây) — KHÔNG BAO GIỜ
# trỏ vào DB dev/prod thật. Để trống nếu không chạy 2 lệnh trên.
SHADOW_DATABASE_URL=

# --- X.AI Copilot (Claude) ---
# Dán API key Anthropic của bạn vào đây (sk-ant-...). Để trống = dùng AI mock.
ANTHROPIC_API_KEY=
# Model mặc định (giữ nguyên nếu không có lý do đổi)
XOFFICE_AI_MODEL=claude-opus-4-8
# Bật gọi AI thật (true) hay dùng mock gateway (false)
XOFFICE_AI_LIVE=false

# --- Tenant demo ---
DEFAULT_TENANT_ID=tenant-xtech
DEFAULT_USER_ID=user-nam

# --- Auth (session/JWT) ---
# Dev secret for signing xhub_session JWT. Set a strong random value in prod.
AUTH_JWT_SECRET=

# --- Auth hardening (ADDITIVE — defaults keep the demo + smokes unchanged) ---
# Enforce authorization: when true, @RequirePermission routes call the identity
# RBAC/ABAC engine and return 403 if the caller lacks the permission.
# Default (unset/false) = soft no-op (demo/dev). PRODUCTION: true.
AUTH_ENFORCE=false
# Accept the dev header identity fallback (x-user-id / x-tenant-id). Default true
# so smokes/legacy FE work. PRODUCTION: false (session cookie only → 401 on
# protected routes without a valid session).
AUTH_ALLOW_HEADER_IDENTITY=true

# --- OIDC seam (adapter-ready; MockOidcProvider only in this build) ---
# Enable the /api/auth/oidc/* routes. Default false. A real Azure AD adapter
# drops in behind OIDC_PROVIDER later — no live IdP call today.
AUTH_OIDC_ENABLED=false
AUTH_OIDC_ISSUER=
AUTH_OIDC_CLIENT_ID=
AUTH_OIDC_CLIENT_SECRET=
AUTH_OIDC_REDIRECT_URI=http://localhost:4000/api/auth/oidc/callback

# --- Staging strictness (G0 hardening) ---
# When true, the server refuses to boot unless AUTH_ENFORCE=true,
# AUTH_ALLOW_HEADER_IDENTITY=false and ANTHROPIC_API_KEY does not match a
# known-leaked fingerprint (src/main.ts assertSecureStartup). Set true in every
# non-local deployment. Default false: local/demo profiles are unaffected.
STAGING_STRICT=false

# --- Per-tenant logical backup (Mục 6) ---
# AES-256-GCM key (32 bytes, base64). Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BACKUP_ENCRYPTION_KEY=

# --- Webhook inbound HMAC signing secret (Mục 8b) ---
# Used ONLY to verify inbound webhook signatures; never persisted.
WEBHOOK_SIGNING_SECRET=

# --- Records / document object storage (Mục 8a, optional) ---
# DOCUMENTS_STORAGE_DIR=./storage/documents
